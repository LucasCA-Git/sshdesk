# Required: long random string. Generate with: openssl rand -base64 48
SECRET_KEY=change-me-change-me-change-me-change-me-change-me
POSTGRES_PASSWORD=change-me

# URL shown in invite emails
PUBLIC_URL=https://sshdesk.example.com

# Set to false after your team created their accounts (invited people can
# still be added: they create the account while registration is open).
ALLOW_REGISTRATION=true
TOKEN_TTL_HOURS=720
INVITE_TTL_DAYS=7

# Optional SMTP for invite emails. Without it, the app shows the invite code
# so the admin can send it by chat.
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SSHDesk <no-reply@example.com>
